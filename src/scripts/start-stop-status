#!/bin/bash
# start / stop / status for the Gopeed engine (+ optional TLS tunnel).
# DSM runs this script as the package user (conf/privilege: run-as=package).
#
# The engine always binds 127.0.0.1:<port+1>; gopeed-tunnel.py fronts <port>.
# It serves http and https on the same port (first byte 0x16 = TLS) and injects
# the CORS headers the DSM desktop needs to call this port from its own origin.
# Only if python3 is missing does the engine bind the public port directly.
set -u

PKG="gopeed"
DEST="${SYNOPKG_PKGDEST:-/var/packages/${PKG}/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/${PKG}/var}"
ETC="${SYNOPKG_PKGETC:-/var/packages/${PKG}/etc}"

BIN="${DEST}/bin/gopeed"
TUNNEL_PY="${DEST}/bin/gopeed-tunnel.py"
SYNC_PY="${DEST}/bin/gopeed-sync.py"
CONF="${ETC}/gopeed.conf"
LOG="${VAR}/gopeed.log"
PID_FILE="${VAR}/gopeed.pid"
TUNNEL_PID="${VAR}/tunnel.pid"
SYNC_PID="${VAR}/sync.pid"

WEB_PORT="__PORT__"
WEB_USER="admin"
WEB_PASS=""
DOWNLOAD_DIR=""
BT_PORT="51413"
ED2K_PORT="4662"
ED2K_UDP_PORT="4672"
AUTO_START="true"
API_TOKEN=""
# Where the engine itself binds while the tunnel fronts it. Loopback keeps the
# raw engine off the LAN; set "[::]" in gopeed.conf to expose it dual-stack.
ENGINE_BIND="127.0.0.1"

INTERNAL_PORT=$((WEB_PORT + 1))

# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOG" 2>/dev/null
}

is_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid="$(head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -r "/proc/${pid}/cmdline" ]; then
        tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -q "bin/gopeed" || return 1
    fi
    return 0
}

tunnel_running() {
    [ -f "$TUNNEL_PID" ] || return 1
    local pid
    pid="$(head -n 1 "$TUNNEL_PID" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -r "/proc/${pid}/cmdline" ]; then
        tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -q "gopeed-tunnel" || return 1
    fi
    return 0
}

port_in_use() {
    netstat -tln 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$1\$"
}

find_python() {
    local c
    for c in /usr/bin/python3 /usr/local/bin/python3 /bin/python3; do
        if [ -x "$c" ]; then
            printf '%s' "$c"
            return 0
        fi
    done
    return 1
}

# The tunnel is required even without a certificate: the DSM desktop loads the
# bundle from /webman/3rdparty/gopeed/app/ (same origin) and calls this port
# cross-origin, so the CORS headers have to be injected here. Without a
# certificate the tunnel simply speaks plain HTTP.
tunnel_available() {
    [ -f "$TUNNEL_PY" ] || return 1
    find_python >/dev/null 2>&1 || return 1
    return 0
}

# Gopeed only applies `downloadConfig` from -c when its storage is created, so a
# re-install (or an upgrade) with an existing var/ keeps the old directory and
# the old protocol ports - the wizard values are silently ignored and the
# settings page shows 0 for BT/ED2K, i.e. random, unreachable ports. Push the
# wanted values through the REST API once the engine is up. The script is
# idempotent, so a no-op start costs one GET.
# shared by the one-shot sync and the watchdog
build_sync_args() {
    SYNC_ARGS=(--port "$1" --dir "$DOWNLOAD_DIR"
               --bt-port "$BT_PORT" --ed2k-tcp "$ED2K_PORT" --ed2k-udp "$ED2K_UDP_PORT"
               --max-running 5)
    [ -n "$WEB_PASS" ] && SYNC_ARGS+=(--user "$WEB_USER" --pass "$WEB_PASS")
    return 0
}

# Gopeed can rewrite its stored config to a default state moments after start
# (seen on a fresh install: maxRunning 0, downloadDir "./", all ports 0), which
# freezes the queue. The watchdog re-checks every minute but only touches a
# config that looks wiped, so values changed in the web UI are left alone.
start_watchdog() {
    local py="$1" port="$2"
    [ -n "$py" ] || return 0
    [ -f "$SYNC_PY" ] || return 0
    build_sync_args "$port"
    nohup "$py" "$SYNC_PY" "${SYNC_ARGS[@]}" --watch 60 >> "$LOG" 2>&1 &
    echo $! > "$SYNC_PID"
    log "config watchdog started pid=$(cat "$SYNC_PID" 2>/dev/null)"
}

stop_watchdog() {
    [ -f "$SYNC_PID" ] || return 0
    local pid
    pid="$(head -n 1 "$SYNC_PID" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$pid" ] && kill -TERM "$pid" 2>/dev/null
    rm -f "$SYNC_PID"
}

sync_settings() {
    local port="$1" attempt=0
    [ -f "$SYNC_PY" ] || { log "no ${SYNC_PY}; download dir and ports NOT synced"; return 0; }
    local py
    py="$(find_python)" || { log "no python3; download dir and ports NOT synced"; return 0; }

    build_sync_args "$port"
    local -a sargs=("${SYNC_ARGS[@]}")

    # The engine binds its port slightly before the config it seeds is actually
    # written, so a single attempt can read a half-initialised config. Retry a
    # few times and let the script itself prove the values landed.
    while [ "$attempt" -lt 3 ]; do
        attempt=$((attempt + 1))
        if "$py" "$SYNC_PY" "${sargs[@]}" >> "$LOG" 2>&1; then
            log "settings verified: dir=${DOWNLOAD_DIR} bt=${BT_PORT} ed2k=${ED2K_PORT}/${ED2K_UDP_PORT}"
            return 0
        fi
        log "settings sync attempt ${attempt} failed"
        [ "$attempt" -lt 3 ] && sleep 3
    done
    log "settings sync FAILED after ${attempt} attempts - the engine keeps its stored config; see the gopeed-sync.py lines above"
    return 0
}

start_tunnel() {
    local py="$1"
    (
        cd "$DEST" || exit 1
        export TUNNEL_PORT="$WEB_PORT"
        export UPSTREAM_PORT="$INTERNAL_PORT"
        export CERT_FILE="$VAR/tls/cert.pem"
        export KEY_FILE="$VAR/tls/privkey.pem"
        nohup "$py" "$TUNNEL_PY" >> "$LOG" 2>&1 &
        echo $! > "$TUNNEL_PID"
    )
}

start_service() {
    if is_running; then
        log "already running"
        return 0
    fi
    [ -x "$BIN" ] || { log "missing binary: ${BIN}"; return 1; }

    mkdir -p "$VAR/tmp" "$VAR/home" 2>/dev/null

    # seed the engine config only on the very first start (see README)
    local fresh=0
    if [ ! -d "$VAR/storage" ] || [ -z "$(ls -A "$VAR/storage" 2>/dev/null)" ]; then
        fresh=1
    fi
    mkdir -p "$VAR/storage" 2>/dev/null

    # A wrong download dir must not keep the service down, but it must not be
    # silently replaced either: the settings page would then show a folder the
    # user never asked for, while the wizard value looked applied. postinst
    # already grants the ACL, so a non-writable dir here means something is
    # genuinely wrong - keep it and say so.
    if [ -n "$DOWNLOAD_DIR" ]; then
        [ -d "$DOWNLOAD_DIR" ] || mkdir -p "$DOWNLOAD_DIR" 2>/dev/null
        if [ ! -w "$DOWNLOAD_DIR" ]; then
            log "ERROR: download dir not writable: ${DOWNLOAD_DIR} - downloads will fail until this is fixed."
            log "       grant it in Control Panel > Shared Folder > Edit > Permissions > System internal users > ${PKG} (read/write), or run: /usr/syno/bin/synoacltool -add ${DOWNLOAD_DIR} \"user:${PKG}:allow:rwxpdDaARWc--:fd--\" ; then restart the package"
        fi
    else
        DOWNLOAD_DIR="$(printf '%s' "$VAR" | cut -d/ -f1-2)/@appshare/${PKG}/downloads"
        [ -d "$DOWNLOAD_DIR" ] || mkdir -p "$DOWNLOAD_DIR" 2>/dev/null
        if [ ! -w "$DOWNLOAD_DIR" ]; then
            log "fallback download dir not writable either: ${DOWNLOAD_DIR}"
            return 1
        fi
    fi

    if port_in_use "$WEB_PORT"; then
        log "port ${WEB_PORT} is already in use: $(netstat -tlnp 2>/dev/null | grep -E "[:.]${WEB_PORT}\$" | head -n 1)"
        return 1
    fi

    local use_tunnel=0 py=""
    if tunnel_available; then
        use_tunnel=1
        py="$(find_python)"
    fi

    local addr port
    if [ "$use_tunnel" = "1" ]; then
        addr="${ENGINE_BIND:-127.0.0.1}"
        port="$INTERNAL_PORT"
    else
        addr="0.0.0.0"
        if [ "$(cat /proc/sys/net/ipv6/bindv6only 2>/dev/null || echo 1)" = "0" ]; then
            addr="[::]"
        fi
        port="$WEB_PORT"
    fi

    local dlcfg
    dlcfg="{\"downloadDir\":\"${DOWNLOAD_DIR}\",\"autoStartTasks\":${AUTO_START},\"protocolConfig\":{\"bt\":{\"listenPort\":${BT_PORT}},\"ed2k\":{\"listenPort\":${ED2K_PORT},\"udpPort\":${ED2K_UDP_PORT}}}}"

    if [ "$fresh" = "1" ]; then
        cat > "$VAR/config.json" <<JSON
{
  "downloadConfig": ${dlcfg}
}
JSON
        log "seeding initial config (storage was empty)"
    else
        # never let a stale seed file override the user's current settings
        rm -f "$VAR/config.json"
    fi

    log "starting gopeed __VERSION__ (__ARCH__): public=${WEB_PORT} bind=${addr}:${port} tunnel=${use_tunnel} downloads=${DOWNLOAD_DIR} bt=${BT_PORT} ed2k=${ED2K_PORT}/${ED2K_UDP_PORT}"

    # -T only makes sense together with -u/-p: the token is validated *instead*
    # of the web session, and passing it alone would leave /api/web/login
    # unregistered, locking the browser UI out.
    local -a eargs=(-A "$addr" -P "$port" -d "$VAR/storage" -c "$VAR/config.json")
    if [ -n "$WEB_PASS" ]; then
        eargs+=(-u "$WEB_USER" -p "$WEB_PASS")
        [ -n "$API_TOKEN" ] && eargs+=(-T "$API_TOKEN")
    fi

    (
        cd "$DEST" || exit 1
        export GOPEED_TEMP_DIR="$VAR/tmp"
        export HOME="$VAR/home"
        nohup "$BIN" "${eargs[@]}" >> "$LOG" 2>&1 &
        echo $! > "$PID_FILE"
    )

    local i=0
    while [ "$i" -lt 15 ]; do
        sleep 1
        if is_running && port_in_use "$port"; then break; fi
        i=$((i + 1))
    done
    if ! is_running; then
        log "start failed: $(tail -n 5 "$LOG" 2>/dev/null | tr '\n' ' ')"
        rm -f "$PID_FILE"
        return 1
    fi

    start_watchdog "$py" "$port"

    if [ "$use_tunnel" = "1" ]; then
        start_tunnel "$py"
        local j=0
        while [ "$j" -lt 10 ]; do
            sleep 1
            if tunnel_running && port_in_use "$WEB_PORT"; then break; fi
            j=$((j + 1))
        done
        if ! tunnel_running; then
            log "tunnel failed to start; web UI may be unreachable on ${WEB_PORT}"
        fi
    fi

    sync_settings "$port"
    if [ -n "$API_TOKEN" ] && [ -n "$WEB_PASS" ]; then
        log "browser extension: address http://<nas>:${WEB_PORT} token ${API_TOKEN}"
    fi
    log "started engine=$(cat "$PID_FILE" 2>/dev/null) tunnel=$(cat "$TUNNEL_PID" 2>/dev/null || echo none)"
    return 0
}

stop_service() {
    local pid i=0
    stop_watchdog
    if tunnel_running; then
        pid="$(head -n 1 "$TUNNEL_PID" | tr -d '[:space:]')"
        log "stopping tunnel pid=${pid}"
        kill -TERM "$pid" 2>/dev/null
    fi
    rm -f "$TUNNEL_PID"

    if is_running; then
        pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
        log "stopping pid=${pid}"
        kill -TERM "$pid" 2>/dev/null
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do
            sleep 1
            i=$((i + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            log "force kill pid=${pid}"
            kill -KILL "$pid" 2>/dev/null
        fi
    fi
    rm -f "$PID_FILE"
    return 0
}

case "${1:-status}" in
    start)
        start_service
        exit $?
        ;;
    stop)
        stop_service
        exit $?
        ;;
    status)
        if is_running; then
            # a live engine without its front tunnel means the UI is unreachable
            if tunnel_available && ! tunnel_running; then
                exit 1
            fi
            exit 0
        fi
        exit 1
        ;;
    restart)
        stop_service
        start_service
        exit $?
        ;;
    *)
        echo "usage: $0 {start|stop|status|restart}" >&2
        exit 1
        ;;
esac
