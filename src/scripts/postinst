#!/bin/bash
# Runs after the payload is unpacked. Creates the data dirs and writes the
# config that start-stop-status consumes. Runs as root, but the service itself
# runs as the package user (DSM 7 refuses unsigned root packages).
set -u

PKG="gopeed"
DEST="${SYNOPKG_PKGDEST:-/var/packages/${PKG}/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/${PKG}/var}"
ETC="${SYNOPKG_PKGETC:-/var/packages/${PKG}/etc}"
CONF="${ETC}/gopeed.conf"

mkdir -p "$VAR/storage" "$VAR/tmp" "$VAR/home" "$ETC" 2>/dev/null || exit 1

# /volume1 (the volume this package was installed on)
VOL="$(printf '%s' "$VAR" | cut -d/ -f1-2)"
DEFAULT_DL="${VOL}/@appshare/${PKG}/downloads"

# Token the browser extension (and any REST client) sends as X-Api-Token.
# Gopeed only accepts it next to a web password: with a blank password the API
# is open anyway, so no token is needed (and passing -T alone would lock the
# web UI out, because /api/web/login is only registered when a password exists).
new_token() {
    head -c 16 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n'
}

# Re-running the wizard normally must NOT overwrite stored settings. The form
# shows the *defaults*, not the live values - and DSM hands those defaults to
# this script even for `synopkg install` from the command line (verified: a CLI
# fresh install arrives with wizard_web_pass="gopeed"), so applying them blindly
# would reset account, ports and download dir: the "settings disappeared after
# upgrade" bug. The wizard's last page has an opt-in checkbox for the case where
# the user really does want to re-apply it (e.g. clearing the password).
RESET=0
case "${wizard_reset_config:-false}" in
    true|TRUE|True|yes|YES|1|on) RESET=1 ;;
esac

if [ -f "$CONF" ]; then
    # shellcheck disable=SC1090
    . "$CONF"
    OLD_TOKEN="${API_TOKEN-}"
    OLD_BIND="${ENGINE_BIND:-127.0.0.1}"
else
    OLD_TOKEN=""
    OLD_BIND=""
fi

if [ -f "$CONF" ] && [ "$RESET" = "0" ]; then
    # keep what the user set, only backfill keys a newer build introduced    WEB_USER="${WEB_USER:-admin}"
    WEB_PASS="${WEB_PASS-}"
    DOWNLOAD_DIR="${DOWNLOAD_DIR:-$DEFAULT_DL}"
    BT_PORT="${BT_PORT:-51413}"
    ED2K_PORT="${ED2K_PORT:-4662}"
    ED2K_UDP_PORT="${ED2K_UDP_PORT:-4672}"
    AUTO_START="${AUTO_START:-true}"
    API_TOKEN="${API_TOKEN-}"
    ENGINE_BIND="${ENGINE_BIND:-127.0.0.1}"
    if [ -z "$API_TOKEN" ]; then
        # conf written by an older version - add the token once
        API_TOKEN="$(new_token)"
        {
            echo "API_TOKEN=\"${API_TOKEN}\""
            echo "ENGINE_BIND=\"${ENGINE_BIND}\""
        } >> "$CONF"
    fi
    echo "$(date '+%Y-%m-%d %H:%M:%S') existing ${CONF} kept (upgrade)" \
        >> "$VAR/install.log" 2>/dev/null
else
    # fresh install, or the user ticked "re-apply the wizard values"
    WEB_USER="${wizard_web_user:-${WEB_USER:-admin}}"
    # A blank password is a valid choice: Gopeed disables web authentication
    # when no password is set, so the UI opens straight into the task list.
    # (${var-def}, not ${var:-def}: an empty value must survive.) An unset
    # variable means "wizard not involved", so keep whatever conf had.
    WEB_PASS="${wizard_web_pass-${WEB_PASS-}}"
    DOWNLOAD_DIR="${wizard_download_dir:-${DOWNLOAD_DIR:-}}"
    BT_PORT="${wizard_bt_port:-${BT_PORT:-51413}}"
    ED2K_PORT="${wizard_ed2k_port:-${ED2K_PORT:-4662}}"
    ED2K_UDP_PORT="${wizard_ed2k_udp_port:-${ED2K_UDP_PORT:-4672}}"
    AUTO_START="true"
    # keep the token/bind across a reset so paired extensions keep working
    API_TOKEN="${OLD_TOKEN:-$(new_token)}"
    # loopback by default: the dual-stack front for the engine is the tunnel on
    # __PORT__. Set "[::]" here to expose the engine itself on every interface.
    ENGINE_BIND="${OLD_BIND:-127.0.0.1}"

    [ -n "$DOWNLOAD_DIR" ] || DOWNLOAD_DIR="$DEFAULT_DL"

    cat > "$CONF" <<EOF
# generated by the Synology package - edit via the app's settings, not by hand
WEB_PORT="__PORT__"
WEB_USER="${WEB_USER}"
WEB_PASS="${WEB_PASS}"
DOWNLOAD_DIR="${DOWNLOAD_DIR}"
BT_PORT="${BT_PORT}"
ED2K_PORT="${ED2K_PORT}"
ED2K_UDP_PORT="${ED2K_UDP_PORT}"
AUTO_START="true"
API_TOKEN="${API_TOKEN}"
ENGINE_BIND="${ENGINE_BIND}"
EOF
    chmod 600 "$CONF"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${CONF} created" \
        >> "$VAR/install.log" 2>/dev/null
fi

# The token has to be pasteable into the browser extension, so keep a readable
# copy next to the share the package owns (File Station: @appshare/gopeed).
if [ -n "${API_TOKEN:-}" ]; then
    mkdir -p "${VOL}/@appshare/${PKG}" 2>/dev/null
    cat > "${VOL}/@appshare/${PKG}/api-token.txt" <<EOF 2>/dev/null
# Gopeed 浏览器扩展 / REST 客户端用的 X-Api-Token
# 扩展里“添加服务器”：地址 http://<NAS地址>:__PORT__ ，令牌填下面这一行
${API_TOKEN}
EOF
    chmod 644 "${VOL}/@appshare/${PKG}/api-token.txt" 2>/dev/null
fi

# Copy DSM's default certificate so the unprivileged tunnel can read it.
# Renewals are picked up on the next install/upgrade (the key is root-only).
CERT_SRC="/usr/syno/etc/certificate/system/default"
if [ -r "$CERT_SRC/privkey.pem" ]; then
    mkdir -p "$VAR/tls"
    if [ -r "$CERT_SRC/fullchain.pem" ]; then
        cp -f "$CERT_SRC/fullchain.pem" "$VAR/tls/cert.pem" 2>/dev/null
    else
        cp -f "$CERT_SRC/cert.pem" "$VAR/tls/cert.pem" 2>/dev/null
    fi
    cp -f "$CERT_SRC/privkey.pem" "$VAR/tls/privkey.pem" 2>/dev/null
    chmod 600 "$VAR/tls/cert.pem" "$VAR/tls/privkey.pem" 2>/dev/null
    echo "$(date '+%Y-%m-%d %H:%M:%S') certificate copied from ${CERT_SRC}" \
        >> "$VAR/install.log" 2>/dev/null
fi

# everything the service touches must belong to the package user
OWNER="$(stat -c %U "$VAR" 2>/dev/null)"
if [ -n "$OWNER" ]; then
    chown -R "$OWNER" "$VAR" "$ETC" 2>/dev/null
fi

# Give the package user write access to the download folder the wizard asked
# for. postinst runs as root, so a fresh install with /volume1/downloads can be
# made to work right away instead of falling back to the package share because
# nobody had granted the ACL yet - that silent fallback is why the settings page
# showed a different directory than the wizard.
#
# DSM shares are ACL based (`ls -l` shows a trailing `+`, and the mode bits are
# usually 000): chown alone does not grant access, synoacltool does.
grant_download_dir() {
    local dir="$1" acltool="/usr/syno/bin/synoacltool"
    [ -n "$dir" ] || return 0
    if [ ! -d "$dir" ]; then
        mkdir -p "$dir" 2>/dev/null || return 0
        # we created it, so giving it away is harmless
        [ -n "$OWNER" ] && chown "$OWNER" "$dir" 2>/dev/null
    fi
    [ -x "$acltool" ] || return 0
    if "$acltool" -get "$dir" 2>/dev/null | grep -q "user:${PKG}:"; then
        return 0
    fi
    # conf/privilege is run-as=package, so this script is NOT root and cannot
    # change a share's ACL ("synoacltool: Access deny"). DSM does not give a
    # third-party package any privileged hook, so the user has to grant it once
    # in Control Panel (or with synoacltool) - say so plainly instead of
    # pretending it worked.
    if [ "$(id -u)" != "0" ]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') acl: ${dir} has no ${PKG} ace yet - grant it in Control Panel > Shared Folder > Edit > Permissions > System internal users, otherwise downloads there fail with permission denied" \
            >> "$VAR/install.log" 2>/dev/null
        return 0
    fi
    if "$acltool" -add "$dir" "user:${PKG}:allow:rwxpdDaARWc--:fd--" \
            >> "$VAR/install.log" 2>&1; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') acl: granted ${PKG} rw on ${dir}" \
            >> "$VAR/install.log" 2>/dev/null
    else
        echo "$(date '+%Y-%m-%d %H:%M:%S') acl: could not grant ${PKG} rw on ${dir}" \
            >> "$VAR/install.log" 2>/dev/null
    fi
}
grant_download_dir "${DOWNLOAD_DIR:-}"

chmod 755 "$DEST/bin/gopeed" 2>/dev/null
exit 0
