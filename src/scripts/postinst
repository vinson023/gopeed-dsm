#!/bin/bash
# Runs after the payload is unpacked. Creates the data dirs and writes the
# config that start-stop-status consumes. Runs as root, but the service itself
# runs as the package user (DSM 7 refuses unsigned root packages).
set -u

PKG="gopeed"
DEST="${SYNOPKG_PKGDEST:-/var/packages/${PKG}/target}"
VAR="${SYNOPKG_PKGVAR:-/var/packages/${PKG}/var}"
ETC="${SYNOPKG_PKGETC:-/var/packages/${PKG}/etc}"
CONF="${ETC}/gopeed.conf"

mkdir -p "$VAR/storage" "$VAR/tmp" "$VAR/home" "$ETC" 2>/dev/null || exit 1

# /volume1 (the volume this package was installed on)
VOL="$(printf '%s' "$VAR" | cut -d/ -f1-2)"
DEFAULT_DL="${VOL}/@appshare/${PKG}/downloads"

# Token the browser extension (and any REST client) sends as X-Api-Token.
# Gopeed only accepts it next to a web password: with a blank password the API
# is open anyway, so no token is needed (and passing -T alone would lock the
# web UI out, because /api/web/login is only registered when a password exists).
new_token() {
    head -c 16 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n'
}

if [ -f "$CONF" ]; then
    # Upgrade / reinstall with "keep data": never touch what the user set.
    # (Wizard variables are empty on a command-line upgrade, so re-writing the
    # file here would silently reset account, ports and download directory.)
    # shellcheck disable=SC1090
    . "$CONF"
    WEB_USER="${WEB_USER:-admin}"
    WEB_PASS="${WEB_PASS-}"
    DOWNLOAD_DIR="${DOWNLOAD_DIR:-$DEFAULT_DL}"
    BT_PORT="${BT_PORT:-51413}"
    ED2K_PORT="${ED2K_PORT:-4662}"
    ED2K_UDP_PORT="${ED2K_UDP_PORT:-4672}"
    AUTO_START="${AUTO_START:-true}"
    API_TOKEN="${API_TOKEN-}"
    ENGINE_BIND="${ENGINE_BIND:-127.0.0.1}"
    if [ -z "$API_TOKEN" ]; then
        # conf written by an older version - add the token once
        API_TOKEN="$(new_token)"
        {
            echo "API_TOKEN=\"${API_TOKEN}\""
            echo "ENGINE_BIND=\"${ENGINE_BIND}\""
        } >> "$CONF"
    fi
    echo "$(date '+%Y-%m-%d %H:%M:%S') existing ${CONF} kept (upgrade)" \
        >> "$VAR/install.log" 2>/dev/null
else
    WEB_USER="${wizard_web_user:-admin}"
    # A blank wizard password is a valid choice: Gopeed disables web
    # authentication when no password is set, so the UI opens straight into the
    # task list. (${var-def}, not ${var:-def}: an empty value must survive.)
    WEB_PASS="${wizard_web_pass-}"
    DOWNLOAD_DIR="${wizard_download_dir:-}"
    BT_PORT="${wizard_bt_port:-51413}"
    ED2K_PORT="${wizard_ed2k_port:-4662}"
    ED2K_UDP_PORT="${wizard_ed2k_udp_port:-4672}"
    AUTO_START="true"
    API_TOKEN="$(new_token)"
    # loopback by default: the dual-stack front for the engine is the tunnel on
    # __PORT__. Set "[::]" here to expose the engine itself on every interface.
    ENGINE_BIND="127.0.0.1"

    [ -n "$DOWNLOAD_DIR" ] || DOWNLOAD_DIR="$DEFAULT_DL"

    cat > "$CONF" <<EOF
# generated by the Synology package - edit via the app's settings, not by hand
WEB_PORT="__PORT__"
WEB_USER="${WEB_USER}"
WEB_PASS="${WEB_PASS}"
DOWNLOAD_DIR="${DOWNLOAD_DIR}"
BT_PORT="${BT_PORT}"
ED2K_PORT="${ED2K_PORT}"
ED2K_UDP_PORT="${ED2K_UDP_PORT}"
AUTO_START="true"
API_TOKEN="${API_TOKEN}"
ENGINE_BIND="${ENGINE_BIND}"
EOF
    chmod 600 "$CONF"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${CONF} created" \
        >> "$VAR/install.log" 2>/dev/null
fi

# The token has to be pasteable into the browser extension, so keep a readable
# copy next to the share the package owns (File Station: @appshare/gopeed).
if [ -n "${API_TOKEN:-}" ]; then
    mkdir -p "${VOL}/@appshare/${PKG}" 2>/dev/null
    cat > "${VOL}/@appshare/${PKG}/api-token.txt" <<EOF 2>/dev/null
# Gopeed 浏览器扩展 / REST 客户端用的 X-Api-Token
# 扩展里“添加服务器”：地址 http://<NAS地址>:__PORT__ ，令牌填下面这一行
${API_TOKEN}
EOF
    chmod 644 "${VOL}/@appshare/${PKG}/api-token.txt" 2>/dev/null
fi

# Copy DSM's default certificate so the unprivileged tunnel can read it.
# Renewals are picked up on the next install/upgrade (the key is root-only).
CERT_SRC="/usr/syno/etc/certificate/system/default"
if [ -r "$CERT_SRC/privkey.pem" ]; then
    mkdir -p "$VAR/tls"
    if [ -r "$CERT_SRC/fullchain.pem" ]; then
        cp -f "$CERT_SRC/fullchain.pem" "$VAR/tls/cert.pem" 2>/dev/null
    else
        cp -f "$CERT_SRC/cert.pem" "$VAR/tls/cert.pem" 2>/dev/null
    fi
    cp -f "$CERT_SRC/privkey.pem" "$VAR/tls/privkey.pem" 2>/dev/null
    chmod 600 "$VAR/tls/cert.pem" "$VAR/tls/privkey.pem" 2>/dev/null
    echo "$(date '+%Y-%m-%d %H:%M:%S') certificate copied from ${CERT_SRC}" \
        >> "$VAR/install.log" 2>/dev/null
fi

# everything the service touches must belong to the package user
OWNER="$(stat -c %U "$VAR" 2>/dev/null)"
if [ -n "$OWNER" ]; then
    chown -R "$OWNER" "$VAR" "$ETC" 2>/dev/null
    mkdir -p "$DOWNLOAD_DIR" 2>/dev/null
    chown "$OWNER" "$DOWNLOAD_DIR" 2>/dev/null
    # NOTE: no writability probe here. `su -c "test -w"` disagrees with the
    # real ACL result on DSM (it reported a writable share as read-only), so
    # the check lives in start-stop-status instead, which already runs as the
    # package user and falls back to the package share with a clear log line.
fi

chmod 755 "$DEST/bin/gopeed" 2>/dev/null
exit 0
