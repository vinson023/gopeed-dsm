[
  {
    "step_title": "访问与安全",
    "items": [
      {
        "type": "textfield",
        "desc": "登录账号",
        "subitems": [
          {
            "key": "wizard_web_user",
            "desc": "默认 admin",
            "defaultValue": "admin",
            "validator": {
              "allowBlank": false,
              "minLength": 1,
              "maxLength": 32,
              "regex": {
                "expr": "/^[A-Za-z0-9_.-]{1,32}$/",
                "errorText": "只能包含字母、数字、_ . -"
              }
            }
          }
        ]
      },
      {
        "type": "password",
        "desc": "登录密码",
        "subitems": [
          {
            "key": "wizard_web_pass",
            "desc": "默认 gopeed",
            "defaultValue": "gopeed",
            "validator": {
              "allowBlank": true,
              "maxLength": 64
            }
          }
        ]
      }
    ]
  },
  {
    "step_title": "下载目录与端口",
    "items": [
      {
        "type": "textfield",
        "desc": "默认下载目录",
        "subitems": [
          {
            "key": "wizard_download_dir",
            "desc": "留空用共享目录",
            "defaultValue": "",
            "validator": {
              "allowBlank": true,
              "maxLength": 255
            }
          }
        ]
      },
      {
        "type": "textfield",
        "desc": "BT 端口",
        "subitems": [
          {
            "key": "wizard_bt_port",
            "desc": "默认 51413",
            "defaultValue": "51413",
            "validator": {
              "allowBlank": false,
              "regex": {
                "expr": "/^[0-9]{2,5}$/",
                "errorText": "端口只能填数字"
              }
            }
          }
        ]
      },
      {
        "type": "textfield",
        "desc": "ED2K TCP",
        "subitems": [
          {
            "key": "wizard_ed2k_port",
            "desc": "默认 4662",
            "defaultValue": "4662",
            "validator": {
              "allowBlank": false,
              "regex": {
                "expr": "/^[0-9]{2,5}$/",
                "errorText": "端口只能填数字"
              }
            }
          }
        ]
      },
      {
        "type": "textfield",
        "desc": "ED2K UDP",
        "subitems": [
          {
            "key": "wizard_ed2k_udp_port",
            "desc": "默认 4672",
            "defaultValue": "4672",
            "validator": {
              "allowBlank": false,
              "regex": {
                "expr": "/^[0-9]{2,5}$/",
                "errorText": "端口只能填数字"
              }
            }
          }
        ]
      }
    ]
  }
]
